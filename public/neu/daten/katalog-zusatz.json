    "textil": { "worteDazu": ["kompressen", "abdecktuch", "abdeckhaube", "tischbezug", "ultraschallbezug", "bezug", "lochtuch", "op-folie", "molltex", "einmalmolltex"], "emdn": ["M01", "M02", "T02"] },
